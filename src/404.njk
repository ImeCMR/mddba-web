---
# Not-found page (Vercel serves it for unknown URLs, at any depth: root-absolute links)
permalink: 404.html
linkMode: abs
pageTitle: Page not found
pageDescription: "The page you are looking for doesn't exist or has moved."
urlPath: /404
noindex: true
eleventyExcludeFromCollections: true
---
{% extends "layouts/base.njk" %}
{% block main %}
<main id="main">
  <section class="solo" data-theme="dark">
    <div class="orb-layer" aria-hidden="true"><span class="orb orb--blue" style="--x:-15%;--y:-40%;--s:65vw;--o:.5"></span><span class="orb orb--deep" style="--x:50%;--y:30%;--s:70vw;--o:.9"></span></div>
    <div class="wrap">
      <p class="label">Error 404</p>
      <h1 class="display-xl">Page <span class="grad">not found.</span></h1>
      <p class="text-xl">The page you are looking for doesn't exist or has moved.</p>
      <div class="btn-row">
        <a class="text-btn" href="/"><span>Back to <strong>Home</strong></span><span class="blob" aria-hidden="true"><svg class="blob__icon" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></span></a>
        <a class="text-btn" href="/pages/news"><span>Latest <strong>News</strong></span><span class="blob" aria-hidden="true"><svg class="blob__icon" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></span></a>
      </div>
    </div>
  </section>
</main>
{% endblock %}
