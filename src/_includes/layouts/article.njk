{#- A news post (src/news/*.md): header, image, text, optional button, share links, then "More News". -#}
{% extends "layouts/base.njk" %}
{% block main %}
{%- set L = linkMode %}
{%- set img = image | imgsize %}
{%- set shareUrl = (settings.siteUrl + pageUrl) | uri %}
{%- set shareTitle = title | uri %}
<main id="main">
  <article>
    <header class="article-hero" data-theme="dark">
      <div class="orb-layer" aria-hidden="true"><span class="orb orb--blue" style="--x:-12%;--y:-55%;--s:60vw;--o:.5"></span><span class="orb orb--deep" style="--x:55%;--y:-5%;--s:55vw;--o:.9"></span></div>
      <div class="wrap wrap--narrow">
        <a class="text-btn text-btn--sm text-btn--back" href="{{ '/pages/news.html' | link(L) }}"><span>Back to <strong>News</strong></span><span class="blob" aria-hidden="true"><svg class="blob__icon" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></span></a>
        <div class="chips">{% for t in topics %}<span class="chip">{{ t }}</span>{% endfor %}</div>
        <h1 class="heading-l">{{ title }}</h1>
        <p class="article-meta label-s"><time datetime="{{ page.date | dateIso }}">{{ page.date | dateLong }}</time></p>
      </div>
    </header>
    <div data-theme="light">
      <div class="wrap wrap--narrow">
        {%- if image %}
        <figure class="article-figure">
          <img src="{{ image | link(L) }}" alt="{{ imageAlt or title }}"{% if img %} width="{{ img.width }}" height="{{ img.height }}"{% endif %} fetchpriority="high" decoding="async">
        </figure>
        {%- endif %}
        <div class="prose">
        {% if lede %}<p class="lede">{{ lede }}</p>{% endif %}
        {{ content | safe }}
        </div>
        {%- if buttonUrl %}
        <div class="btn-row" style="margin-top:40px">{% set href = buttonUrl | link(L) %}{% set label = buttonText or 'Read **more**' %}{% include "partials/text-btn.njk" %}</div>
        {%- endif %}
        <div class="share">
          <p class="label">Share this story</p>
          <div class="social"><a href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-facebook"/></svg></a><a href="https://x.com/intent/post?url={{ shareUrl }}&amp;text={{ shareTitle }}" target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-x"/></svg></a><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-linkedin"/></svg></a><a href="https://wa.me/?text={{ shareTitle }}%20{{ shareUrl }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-whatsapp"/></svg></a><a href="https://t.me/share/url?url={{ shareUrl }}&amp;text={{ shareTitle }}" target="_blank" rel="noopener" aria-label="Share on Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-telegram"/></svg></a><a href="mailto:?subject={{ shareTitle }}&amp;body={{ shareUrl }}" aria-label="Share by email"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-mail"/></svg></a></div>
        </div>
      </div>
    </div>
  </article>
{#- the two newest other posts #}
{%- set more = collections.posts | without(page.url) | head(2) %}
{%- if more.length %}

  <section class="section" data-theme="light" aria-labelledby="more-title">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">Keep Reading</p>
          <h2 class="heading-m" id="more-title">More News</h2>
        </div>
        <a class="text-btn" href="{{ '/pages/news.html' | link(L) }}"><span>See all <strong>News</strong></span><span class="blob" aria-hidden="true"><svg class="blob__icon" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></span></a>
      </div>
      <div class="card-grid card-grid--2">
      {%- for post in more %}{% set i = loop.index0 %}
{% include "partials/news-card.njk" %}
      {%- endfor %}
      </div>
    </div>
  </section>
{%- endif %}
</main>
{% endblock %}
