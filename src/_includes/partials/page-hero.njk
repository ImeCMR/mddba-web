  <section class="page-hero" data-theme="dark">
    <div class="orb-layer" aria-hidden="true"><span class="orb orb--blue" style="--x:-10%;--y:-60%;--s:60vw;--o:.55"></span><span class="orb orb--deep" style="--x:55%;--y:-10%;--s:55vw;--o:.9"></span><span class="orb orb--sky" style="--x:78%;--y:40%;--s:26vw;--o:.3"></span></div>
    <div class="wrap relative">
      <p class="label">{{ hero.label }}</p>
      <h1 class="display-xl page-hero__title">{{ hero.title | grad | safe }}</h1>
      <p class="text-xl page-hero__sub">{{ hero.text }}</p>
    </div>
  </section>
